# DMM アフィリエイト API
DMM_API_ID=your_dmm_api_id
DMM_AFFILIATE_ID=your_affiliate_id-990

# Google Gemini
GEMINI_API_KEY=your-gemini-api-key

# X (Twitter) API v1.1 OAuth 1.0a User Context
X_API_KEY=your_x_api_key
X_API_SECRET=your_x_api_secret
X_ACCESS_TOKEN=your_x_access_token
X_ACCESS_SECRET=your_x_access_secret

# GitHub Pages 公開ベース URL（末尾スラッシュなし）
# 例: https://yourusername.github.io/your-repo
# ※ GitHub Secrets では GITHUB_ 接頭辞が使えないため BASE_URL を使用
BASE_URL=https://dedicatebabe.github.io/fanza-auto-system
